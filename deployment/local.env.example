# Copy values into your shell or a local .env loader before running the demo.
# This file is documentation only; the current scripts read process environment variables.

# Backend
# Demo / local only:
# APP_DATABASE_URL=sqlite:///./data/demo.sqlite3
# Future PostgreSQL target path:
# APP_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/software_cup_a3
APP_DATABASE_URL=sqlite:///./data/demo.sqlite3
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
PYTHONPATH=src/backend

# Frontend development server
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Browser smoke override for machines without Microsoft Edge.
# Example: chromium, chrome, msedge
PLAYWRIGHT_CHANNEL=msedge

# RAG retrieval
# Default stays local and deterministic: text/markdown import -> chunks -> SQLite keyword search.
RAG_RETRIEVAL_MODE=keyword
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80
RAG_AUTO_INDEX=false
RAG_EMBEDDING_ENABLED=false
RAG_VECTOR_STORE=sqlite_cosine
RAG_VECTOR_MAX_CANDIDATES=1000
RAG_KEYWORD_WEIGHT=0.45
RAG_VECTOR_WEIGHT=0.55
RAG_RERANK_ENABLED=false
RAG_RERANK_MAX_CANDIDATES=12
RAG_RERANK_TOP_CONTEXT=5
RAG_RERANK_CONTEXT_CHAR_LIMIT=3500

# Optional SQLite hybrid retrieval. Keep keys in your shell or secret manager.
# RAG_RETRIEVAL_MODE=hybrid
# RAG_EMBEDDING_ENABLED=true
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=<provider-base-url>
# EMBEDDING_MODEL=<embedding-model>
# EMBEDDING_API_KEY=
# EMBEDDING_TIMEOUT_SECONDS=10
# EMBEDDING_MAX_RETRIES=0
# EMBEDDING_BYPASS_PROXY=false

# LLM provider
# Dev/demo default should remain rule_based so local smoke does not require a network call or secret.
# Future OpenAI-compatible provider values should be injected via shell environment or deployment secrets.
LLM_PROVIDER=rule_based
LLM_ENABLE_FOR_TUTOR=false
LLM_ENABLE_FOR_RESOURCE=false
LLM_ENABLE_FOR_EVALUATOR=false
LLM_ENABLE_FOR_PROFILE_UPDATER=false
LLM_ENABLE_FOR_PROFILE_BUILDER=false
LLM_ENABLE_FOR_PLANNER=false
LLM_ENABLE_FOR_QUIZ=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=0
LLM_MAX_TOKENS=1024
# Optional purpose-specific overrides, for example:
# LLM_PLANNER_TIMEOUT_SECONDS=18
# LLM_PLANNER_MAX_RETRIES=0
# LLM_PLANNER_MAX_TOKENS=600
# LLM_TUTOR_TIMEOUT_SECONDS=25
# LLM_TUTOR_MAX_RETRIES=0
# LLM_TUTOR_MAX_TOKENS=800
# LLM_RESOURCE_TIMEOUT_SECONDS=30
# LLM_RESOURCE_MAX_RETRIES=0
# LLM_RESOURCE_MAX_TOKENS=1200
LLM_FALLBACK_MODE=rule_based
LLM_BYPASS_PROXY=false

# DeepSeek OpenAI-compatible example for explicit local opt-in.
# Keep LLM_API_KEY in your shell or secret manager; never commit a real key.
# LLM_PROVIDER=openai_compatible
# LLM_ENABLE_FOR_TUTOR=true
# LLM_ENABLE_FOR_RESOURCE=true
# LLM_ENABLE_FOR_EVALUATOR=true
# LLM_ENABLE_FOR_PROFILE_UPDATER=true
# LLM_ENABLE_FOR_PROFILE_BUILDER=true
# LLM_ENABLE_FOR_PLANNER=true
# LLM_ENABLE_FOR_QUIZ=true
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-flash
# LLM_BYPASS_PROXY=true
